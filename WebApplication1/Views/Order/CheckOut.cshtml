@model WebApplication1.FoodViewModels.CheckoutViewModel

@{
    Layout = "_NavbarUserLayout";
    ViewData["Title"] = "Checkout";
}

<div class="checkout-page container py-4 py-lg-5">
    <!-- PAGE HEADER -->
    <div class="checkout-hero mb-4 mb-lg-5">
        <div class="checkout-hero-badge">ยืนยันคำสั่งซื้อ</div>
        <h2 class="checkout-title mb-2">ตรวจสอบรายการก่อนสั่งซื้อ</h2>
        <p class="checkout-subtitle mb-0">
            เลือกที่อยู่จัดส่ง ตรวจสอบเมนู และยืนยันคำสั่งซื้อได้ในหน้าเดียว
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm">@TempData["Success"]</div>
    }

    <form asp-controller="Order" asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <!-- ใช้ hidden เป็นตัวส่งค่าจริงเข้า controller -->
        <input type="hidden" name="UseNewAddress" id="UseNewAddressHidden" value="false" />
        <input type="hidden" name="SaveNewAddressToBook" id="SaveNewAddressToBookHidden" value="false" />

        <div class="row g-4 g-lg-4">
            <!-- LEFT -->
            <div class="col-12 col-lg-8">

                <!-- ที่อยู่จัดส่ง -->
                <div class="checkout-card mb-4">
                    <div class="checkout-card-body p-4 p-lg-4">
                        <div class="section-head mb-3">
                            <div class="section-icon">📍</div>
                            <div>
                                <h5 class="section-title mb-1">ที่อยู่จัดส่ง</h5>
                                <div class="section-subtitle">เลือกที่อยู่เดิม หรือกรอกที่อยู่ใหม่สำหรับออเดอร์นี้</div>
                            </div>
                        </div>

                        @if (Model.Addresses != null && Model.Addresses.Any())
                        {
                            <div class="mb-3" id="savedAddressSection">
                                @for (int i = 0; i < Model.Addresses.Count; i++)
                                {
                                    var addr = Model.Addresses[i];

                                    <div class="form-check address-card p-3 mb-3">
                                        <input class="form-check-input address-radio"
                                               type="radio"
                                               name="SelectedAddressId"
                                               value="@addr.AddressId"
                                               id="addr_@addr.AddressId"
                                               @(i == 0 ? "checked" : null) />

                                        <label class="form-check-label w-100 ms-2" for="addr_@addr.AddressId" style="cursor:pointer;">
                                            <div class="address-name">@addr.UserName (@addr.ReceiverPhone)</div>
                                            <div class="address-detail">
                                                @addr.AddressDetail ต.@addr.SubDistrict อ.@addr.District จ.@addr.Province
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-4 border-0 shadow-sm">
                                คุณยังไม่มีที่อยู่ที่บันทึกไว้ กรุณากรอกที่อยู่ใหม่ด้านล่าง
                            </div>
                        }

                        <div class="form-check mt-3 custom-check-row">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="useNewAddress"
                                   value="true"
                                   @(Model.Addresses == null || !Model.Addresses.Any() ? "checked" : null) />
                            <label class="form-check-label fw-semibold" for="useNewAddress">
                                ใช้ที่อยู่ใหม่สำหรับออเดอร์นี้
                            </label>
                        </div>

                        <div id="newAddressSection" class="mt-4 d-none">
                            <div class="new-address-box">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label field-label">ชื่อผู้รับ <span class="text-danger">*</span></label>
                                        <input type="text" name="NewReceiverName" class="form-control checkout-input" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label field-label">เบอร์โทรผู้รับ <span class="text-danger">*</span></label>
                                        <input type="text" name="NewReceiverPhone" class="form-control checkout-input" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label field-label">รายละเอียดที่อยู่ <span class="text-danger">*</span></label>
                                        <textarea name="NewAddressDetail"
                                                  class="form-control checkout-input"
                                                  rows="3"
                                                  placeholder="เช่น 99/9 หมู่ 2 ซอย 5 ถนน...."></textarea>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label field-label">ตำบล / แขวง <span class="text-danger">*</span></label>
                                        <input type="text" name="NewSubDistrict" class="form-control checkout-input" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label field-label">อำเภอ / เขต <span class="text-danger">*</span></label>
                                        <input type="text" name="NewDistrict" class="form-control checkout-input" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label field-label">จังหวัด <span class="text-danger">*</span></label>
                                        <input type="text" name="NewProvince" class="form-control checkout-input" />
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check mt-2 custom-check-row">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="saveNewAddressToBook"
                                                   value="true"
                                                   checked />
                                            <label class="form-check-label" for="saveNewAddressToBook">
                                                บันทึกที่อยู่นี้ไว้ใช้ครั้งถัดไป
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="helper-note mt-3">
                            * หากไม่เลือกที่อยู่ใหม่ ระบบจะใช้ที่อยู่ที่เลือกไว้ด้านบน
                        </div>
                    </div>
                </div>

                <!-- รายการสินค้า -->
                <div class="checkout-card">
                    <div class="checkout-card-body p-4 p-lg-4">
                        <div class="section-head mb-3">
                            <div class="section-icon">🍽️</div>
                            <div>
                                <h5 class="section-title mb-1">รายการสินค้า</h5>
                                <div class="section-subtitle">ตรวจสอบเมนู จำนวน และโปรโมชั่นก่อนยืนยัน</div>
                            </div>
                        </div>

                        @foreach (var item in Model.CartItems)
                        {
                            <div class="order-item-row">
                                <div class="d-flex gap-3 align-items-start flex-grow-1">
                                    <img src="@item.MenuImage"
                                         alt="@item.MenuName"
                                         class="order-item-img"
                                         onerror="this.src='/img/menu/default-food.jpg'" />

                                    <div>
                                        <div class="order-item-name">@item.MenuName</div>

                                        <div class="order-item-meta">
                                            จำนวน @item.Quantity
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.OptionSummary) && item.OptionSummary != "-")
                                        {
                                            <div class="order-item-meta">
                                                ตัวเลือก: @item.OptionSummary
                                            </div>
                                        }

                                        @if (item.HasPromotion)
                                        {
                                            <div class="order-item-promo">
                                                โปรโมชัน: @item.PromotionName
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="order-item-price text-end">
                                    @if (item.HasPromotion)
                                    {
                                        <div class="order-old-price">
                                            ฿@item.OriginalTotalPrice.ToString("0.00")
                                        </div>

                                        <div class="order-discount">
                                            - ฿@item.TotalDiscountAmount.ToString("0.00")
                                        </div>
                                    }

                                    <div class="order-final-price">
                                        ฿@item.TotalPrice.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-12 col-lg-4">
                <div class="checkout-card sticky-top checkout-summary-card" style="top: 24px;">
                    <div class="checkout-card-body p-4">
                        <div class="summary-top mb-3">
                            <div>
                                <h5 class="section-title mb-1">สรุปยอดชำระ</h5>
                                <div class="section-subtitle">ยอดสุดท้ายก่อนยืนยันออเดอร์</div>
                            </div>
                        </div>

                        <div class="summary-line">
                            <span class="summary-label">ยอดรวมก่อนส่วนลด</span>
                            <span class="summary-value">฿@Model.TotalPrice.ToString("0.00")</span>
                        </div>

                        <div class="summary-line">
                            <span class="summary-label">ส่วนลดรวม</span>
                            <span class="summary-value text-success">- ฿@Model.DiscountAmount.ToString("0.00")</span>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="summary-total-line">
                            <span class="summary-total-label">ยอดสุทธิ</span>
                            <span class="summary-total-value">฿@Model.FinalPrice.ToString("0.00")</span>
                        </div>

                        <button type="submit" class="btn btn-place-order w-100 mt-4" id="btnPlaceOrder">
                            ยืนยันสั่งซื้อ
                        </button>

                        <!-- เหลือปุ่มกลับไปตะกร้าแค่ตรงนี้อันเดียว -->
                        <a asp-controller="Menu" asp-action="MenuUser" class="btn btn-back-cart w-100 mt-2">
                            กลับไปหน้าแรก
                        </a>

                        <div class="helper-note mt-3">
                            * หลังยืนยันคำสั่งซื้อ ระบบจะส่งออเดอร์ให้พนักงานตรวจสอบก่อน แล้วจึงชำระเงินในหน้าสถานะคำสั่งซื้อ
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .checkout-page {
        font-family: 'Prompt', sans-serif;
        color: #003049;
    }

    .checkout-hero {
        background: #fffdf8;
        border: 1px solid #eadfca;
        border-radius: 28px;
        padding: 22px 24px;
        box-shadow: 0 8px 24px rgba(0,0,0,.03);
    }

    .checkout-hero-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 999px;
        background: #FDF7EA;
        border: 1px solid #eadfca;
        color: #AA132A;
        font-size: .82rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .checkout-title {
        font-size: clamp(1.7rem, 2.8vw, 2.35rem);
        font-weight: 800;
        color: #003049;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }

    .checkout-subtitle {
        color: #6b7280;
        font-size: .98rem;
        font-weight: 400;
        line-height: 1.6;
    }

    .checkout-card {
        background: #fff;
        border: 1px solid #eadfca;
        border-radius: 28px;
        box-shadow: 0 10px 24px rgba(0,0,0,.035);
        overflow: hidden;
    }

    .checkout-card-body {
        position: relative;
    }

    .section-head {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: #FDF7EA;
        border: 1px solid #eadfca;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #003049;
        letter-spacing: -0.01em;
    }

    .section-subtitle {
        font-size: .86rem;
        color: #7b8794;
        line-height: 1.5;
    }

    .address-card {
        transition: all 0.2s ease;
        border: 1px solid #e9dcc8 !important;
        border-radius: 18px !important;
        background: #fff;
    }

    .address-card:hover {
        border-color: #d9b98c !important;
        box-shadow: 0 0 0 0.15rem rgba(233,195,114,.10);
    }

    .address-card.active {
        border-color: #AA132A !important;
        background-color: #fffafa;
        box-shadow: 0 0 0 0.15rem rgba(170,19,42,.08);
    }

    .address-card.disabled-card {
        opacity: 0.55;
        pointer-events: none;
    }

    .address-name {
        font-weight: 700;
        color: #003049;
        margin-bottom: 4px;
    }

    .address-detail {
        color: #6b7280;
        font-size: .92rem;
        line-height: 1.5;
    }

    .custom-check-row .form-check-input {
        border-radius: 8px;
    }

    .new-address-box {
        border: 1px solid #f0e6d5;
        background: #fffdf9;
        border-radius: 20px;
        padding: 18px;
    }

    .field-label {
        font-weight: 600;
        color: #003049;
        font-size: .92rem;
    }

    .checkout-input {
        border-radius: 14px;
        border: 1px solid #e8dcc7;
        padding: .75rem .95rem;
        box-shadow: none !important;
        font-size: .95rem;
    }

    .checkout-input:focus {
        border-color: #E9C372;
        box-shadow: 0 0 0 .2rem rgba(233,195,114,.15) !important;
    }

    .helper-note {
        font-size: .84rem;
        color: #7b8794;
        line-height: 1.55;
    }

    .order-item-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #f1e7d7;
        flex-wrap: wrap;
    }

    .order-item-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .order-item-img {
        width: 76px;
        height: 76px;
        object-fit: cover;
        border-radius: 18px;
        border: 1px solid #f0e6d5;
        background: #f8f6f0;
    }

    .order-item-name {
        font-weight: 700;
        color: #003049;
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .order-item-meta {
        font-size: .9rem;
        color: #6b7280;
        line-height: 1.5;
    }

    .order-item-promo {
        margin-top: 4px;
        font-size: .88rem;
        color: #2d7a4f;
        font-weight: 600;
    }

    .order-item-price {
        min-width: 140px;
    }

    .order-old-price {
        color: #8c98a4;
        font-size: .86rem;
        text-decoration: line-through;
    }

    .order-discount {
        color: #2d7a4f;
        font-size: .88rem;
        font-weight: 600;
    }

    .order-final-price {
        color: #AA132A;
        font-size: 1.08rem;
        font-weight: 800;
    }

    .checkout-summary-card {
        background: #fffdf8;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f1e7d7;
    }

    .summary-label {
        color: #6b7280;
        font-size: .95rem;
    }

    .summary-value {
        color: #003049;
        font-weight: 700;
        font-size: .96rem;
    }

    .summary-divider {
        margin: 14px 0 10px;
        border-top: 1px dashed #e2d6c2;
    }

    .summary-total-line {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
    }

    .summary-total-label {
        font-size: 1.1rem;
        font-weight: 800;
        color: #003049;
    }

    .summary-total-value {
        font-size: 1.75rem;
        font-weight: 900;
        color: #AA132A;
        line-height: 1;
    }

    .btn-place-order {
        border: none;
        border-radius: 16px;
        background: #AA132A;
        color: #fff;
        padding: 12px 18px;
        font-weight: 700;
        font-size: .96rem;
        box-shadow: 0 10px 20px rgba(170,19,42,.15);
        transition: all .2s ease;
    }

    .btn-place-order:hover {
        background: #8f1023;
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-back-cart {
        border-radius: 16px;
        padding: 12px 18px;
        font-weight: 700;
        font-size: .95rem;
        border: 1px solid #d8ccb7;
        background: #fff;
        color: #003049;
        text-decoration: none;
        transition: all .2s ease;
    }

    .btn-back-cart:hover {
        background: #FDF7EA;
        color: #003049;
        border-color: #cdbb9b;
    }

    @@media (max-width: 991.98px) {
        .checkout-summary-card {
            position: static !important;
            top: auto !important;
        }
    }
</style>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const useNewAddress = document.getElementById("useNewAddress");
        const useNewAddressHidden = document.getElementById("UseNewAddressHidden");

        const saveNewAddressToBook = document.getElementById("saveNewAddressToBook");
        const saveNewAddressToBookHidden = document.getElementById("SaveNewAddressToBookHidden");

        const newAddressSection = document.getElementById("newAddressSection");
        const addressRadios = document.querySelectorAll(".address-radio");
        const addressCards = document.querySelectorAll(".address-card");
        const btnPlaceOrder = document.getElementById("btnPlaceOrder");

        const newReceiverName = document.querySelector('input[name="NewReceiverName"]');
        const newReceiverPhone = document.querySelector('input[name="NewReceiverPhone"]');
        const newAddressDetail = document.querySelector('textarea[name="NewAddressDetail"]');
        const newSubDistrict = document.querySelector('input[name="NewSubDistrict"]');
        const newDistrict = document.querySelector('input[name="NewDistrict"]');
        const newProvince = document.querySelector('input[name="NewProvince"]');

        const newInputs = [
            newReceiverName,
            newReceiverPhone,
            newAddressDetail,
            newSubDistrict,
            newDistrict,
            newProvince
        ];

        function refreshSelectedAddressUI() {
            addressCards.forEach(card => card.classList.remove("active"));

            if (useNewAddress.checked) return;

            addressRadios.forEach(radio => {
                if (radio.checked) {
                    radio.closest(".address-card")?.classList.add("active");
                }
            });
        }

        function toggleNewAddress() {
            const checked = useNewAddress.checked;

            if (useNewAddressHidden) {
                useNewAddressHidden.value = checked ? "true" : "false";
            }

            if (checked) {
                newAddressSection.classList.remove("d-none");

                addressRadios.forEach(r => {
                    r.checked = false;
                    r.disabled = true;
                });

                addressCards.forEach(card => {
                    card.classList.remove("active");
                    card.classList.add("disabled-card");
                });

                newInputs.forEach(input => {
                    if (input) input.required = true;
                });

                if (saveNewAddressToBook) {
                    saveNewAddressToBook.disabled = false;
                    if (saveNewAddressToBookHidden) {
                        saveNewAddressToBookHidden.value = saveNewAddressToBook.checked ? "true" : "false";
                    }
                }
            } else {
                newAddressSection.classList.add("d-none");

                addressRadios.forEach(r => {
                    r.disabled = false;
                });

                addressCards.forEach(card => {
                    card.classList.remove("disabled-card");
                });

                const anyChecked = Array.from(addressRadios).some(r => r.checked);
                if (!anyChecked && addressRadios.length > 0) {
                    addressRadios[0].checked = true;
                }

                newInputs.forEach(input => {
                    if (input) input.required = false;
                });

                if (saveNewAddressToBook) {
                    saveNewAddressToBook.disabled = true;
                }

                if (saveNewAddressToBookHidden) {
                    saveNewAddressToBookHidden.value = "false";
                }

                refreshSelectedAddressUI();
            }
        }

        addressRadios.forEach(radio => {
            radio.addEventListener("change", function () {
                if (radio.checked) {
                    useNewAddress.checked = false;
                    toggleNewAddress();
                }
            });
        });

        useNewAddress.addEventListener("change", function () {
            toggleNewAddress();
        });

        if (saveNewAddressToBook) {
            saveNewAddressToBook.addEventListener("change", function () {
                if (saveNewAddressToBookHidden) {
                    saveNewAddressToBookHidden.value = saveNewAddressToBook.checked ? "true" : "false";
                }
            });
        }

        if (btnPlaceOrder) {
            btnPlaceOrder.addEventListener("click", function () {
                setTimeout(function () {
                    btnPlaceOrder.disabled = true;
                    btnPlaceOrder.innerText = "กำลังส่งคำสั่งซื้อ...";
                }, 100);
            });
        }

        toggleNewAddress();
        refreshSelectedAddressUI();
    });
</script>
}