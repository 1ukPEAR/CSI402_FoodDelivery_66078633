@model WebApplication1.FoodViewModels.AuthViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>

    <!-- Google Font: Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Boxicons -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <style>
        :root {
            /* ===== Brand Palette ===== */
            --primary-red: #AA132A;      /* Tabasco Red */
            --secondary-soft: #E0C5A7;   /* Cameo */
            --bg-main: #FDF7EA;          /* Half Colonial White */
            --navy: #003049;             /* Navy */

            /* ===== UI Tokens ===== */
            --card-bg: #FFFFFF;
            --text-dark: var(--navy);
            --text-muted: #5F6B77;
            --border-soft: var(--secondary-soft);
            --input-bg: #FFFDF8;
            --focus-ring: rgba(170, 19, 42, 0.08);
            --shadow-main: 0 14px 32px rgba(0, 48, 73, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            font-family: 'Kanit', sans-serif;
            background: var(--bg-main);
            color: var(--text-dark);
        }

        .forgot-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .forgot-card {
            width: 100%;
            max-width: 500px;
            border-radius: 22px;
            overflow: hidden;
            background: var(--card-bg);
            box-shadow: var(--shadow-main);
            border: 1px solid rgba(224, 197, 167, 0.75);
        }

        .cover-wrap {
            position: relative;
            height: 160px;
            overflow: hidden;
            background: #111;
        }

        .cover-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: brightness(0.82) contrast(1.02);
        }

        .cover-wrap::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 48, 73, 0.18);
        }

        /* ปุ่มกลับซ้ายบน */
        .back-btn {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #fff;
            text-decoration: none;
            font-size: 0.84rem;
            font-weight: 500;
            transition: all 0.2s ease;
            backdrop-filter: blur(4px);
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.22);
            color: #fff;
        }

        .back-btn i {
            font-size: 18px;
        }

        .card-body-custom {
            padding: 24px;
        }

        .header-block {
            text-align: center;
            margin-bottom: 18px;
        }

        .page-title {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--navy);
            line-height: 1.2;
        }

        .page-subtitle {
            margin: 6px 0 0;
            color: var(--text-muted);
            font-size: 0.92rem;
            font-weight: 300;
            line-height: 1.4;
        }

        .form-label {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .form-control {
            min-height: 46px;
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            background: var(--input-bg);
            padding: 10px 46px 10px 14px;
            font-size: 0.95rem;
            color: var(--navy);
            box-shadow: none !important;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: rgba(170, 19, 42, 0.35);
            background: #fff;
            box-shadow: 0 0 0 4px var(--focus-ring) !important;
        }

        .password-wrap {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #7b6f62;
            font-size: 20px;
            line-height: 1;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toggle-password:hover {
            color: var(--primary-red);
        }

        .alert {
            border-radius: 14px;
            font-size: 0.9rem;
            padding: 12px 14px;
            border: 1px solid transparent;
        }

        .alert-danger {
            background: #fff5f5;
            border-color: rgba(170, 19, 42, 0.15);
            color: #8f1023;
        }

        .alert-success {
            background: #f5f8f1;
            border-color: rgba(126, 131, 100, 0.18);
            color: #5f664a;
        }

        .btn-reset {
            width: 100%;
            min-height: 48px;
            border: none;
            border-radius: 14px;
            background: var(--primary-red);
            color: #fff;
            font-size: 0.98rem;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.14);
        }

        .btn-reset:hover {
            background: #930F23;
            transform: translateY(-1px);
            color: #fff;
        }

        @@media (max-width: 576px) {
            .forgot-page {
                padding: 14px;
            }

            .forgot-card {
                border-radius: 18px;
            }

            .cover-wrap {
                height: 145px;
            }

            .card-body-custom {
                padding: 20px 18px;
            }

            .page-title {
                font-size: 1.55rem;
            }

            .page-subtitle {
                font-size: 0.88rem;
            }

            .back-btn span {
                display: none;
            }

            .back-btn {
                width: 36px;
                height: 36px;
                padding: 0;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <div class="forgot-page">
        <div class="forgot-card">

            <!-- รูปด้านบน -->
            <div class="cover-wrap">
                <img src="~/img/RegisterPic.jpg" alt="Forgot Password Cover" />

                <!-- ปุ่มกลับหน้า Login -->
                <a asp-controller="Auth"
                   asp-action="Login"
                   class="back-btn">
                    <i class="bx bx-arrow-back"></i>
                    <span>Back to Login</span>
                </a>
            </div>

            <!-- เนื้อหาการ์ด -->
            <div class="card-body-custom">
                <div class="header-block">
                    <h3 class="page-title">Forgot Password</h3>
                    <p class="page-subtitle">เปลี่ยนรหัสผ่านสำหรับลูกค้า</p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Enter your username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <div class="password-wrap">
                            <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Enter new password" />
                            <button type="button" class="toggle-password" onclick="togglePassword('newPassword', this)">
                                <i class="bx bx-hide"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirm New Password</label>
                        <div class="password-wrap">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirm new password" />
                            <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)">
                                <i class="bx bx-hide"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-reset">
                        เปลี่ยนรหัสผ่าน
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bx-hide');
                icon.classList.add('bx-show');
            } else {
                input.type = 'password';
                icon.classList.remove('bx-show');
                icon.classList.add('bx-hide');
            }
        }
    </script>

</body>
</html>