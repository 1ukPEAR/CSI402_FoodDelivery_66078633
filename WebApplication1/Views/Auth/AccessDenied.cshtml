@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied</title>

    <!-- Google Font: Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Boxicons -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <style>
        :root {
            /* ===== Brand Palette ===== */
            --primary-red: #AA132A;
            --secondary-soft: #E0C5A7;
            --bg-main: #FDF7EA;
            --navy: #003049;

            /* ===== UI Tokens ===== */
            --card-bg: #FFFFFF;
            --text-dark: var(--navy);
            --text-muted: #5F6B77;
            --border-soft: var(--secondary-soft);
            --shadow-main: 0 14px 32px rgba(0, 48, 73, 0.08);
            --danger-soft: #FFF4F4;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            font-family: 'Kanit', sans-serif;
            background: var(--bg-main);
            color: var(--text-dark);
        }

        .denied-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .denied-card {
            width: 100%;
            max-width: 540px;
            border-radius: 22px;
            overflow: hidden;
            background: var(--card-bg);
            box-shadow: var(--shadow-main);
            border: 1px solid rgba(224, 197, 167, 0.75);
        }

        .cover-wrap {
            position: relative;
            height: 160px;
            overflow: hidden;
            background: #111;
        }

        .cover-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: brightness(0.78) contrast(1.02);
        }

        .cover-wrap::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 48, 73, 0.25);
        }

        .card-body-custom {
            padding: 26px 24px 24px;
            text-align: center;
        }

        .icon-wrap {
            width: 84px;
            height: 84px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: var(--danger-soft);
            border: 1px solid rgba(170, 19, 42, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-red);
            font-size: 42px;
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.06);
        }

        .brand-title {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--navy);
            line-height: 1.2;
        }

        .brand-subtitle {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 300;
            line-height: 1.6;
        }

        .message-box {
            margin-top: 20px;
            padding: 16px 18px;
            border-radius: 16px;
            background: #FFFDF8;
            border: 1px solid rgba(224, 197, 167, 0.65);
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        .btn-group-custom {
            margin-top: 22px;
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-main {
            min-width: 150px;
            min-height: 46px;
            border: none;
            border-radius: 14px;
            background: var(--primary-red);
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.14);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 18px;
        }

        .btn-main:hover {
            background: #930F23;
            transform: translateY(-1px);
            color: #fff;
        }

        .btn-secondary-custom {
            min-width: 150px;
            min-height: 46px;
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            background: #FFFDF8;
            color: var(--navy);
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 18px;
        }

        .btn-secondary-custom:hover {
            background: #fff;
            color: var(--primary-red);
            border-color: var(--primary-red);
        }

        .footer-note {
            text-align: center;
            padding: 14px 16px 18px;
            color: var(--text-muted);
            font-size: 0.86rem;
            font-weight: 300;
            border-top: 1px solid rgba(224, 197, 167, 0.55);
        }

        @@media (max-width: 576px) {
            .denied-page {
                padding: 14px;
            }

            .denied-card {
                border-radius: 18px;
            }

            .cover-wrap {
                height: 145px;
            }

            .card-body-custom {
                padding: 22px 18px 20px;
            }

            .brand-title {
                font-size: 1.55rem;
            }

            .brand-subtitle {
                font-size: 0.9rem;
            }

            .btn-group-custom {
                flex-direction: column;
            }

            .btn-main,
            .btn-secondary-custom {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="denied-page">
        <div class="denied-card">

            <!-- รูปด้านบน -->
            <div class="cover-wrap">
                <img src="~/img/RegisterPic.jpg" alt="Access Denied Cover" />
            </div>

            <!-- เนื้อหาการ์ด -->
            <div class="card-body-custom">
                <div class="icon-wrap">
                    <i class='bx bx-block'></i>
                </div>

                <h2 class="brand-title">ไม่มีสิทธิ์เข้าถึง</h2>
                <p class="brand-subtitle">Access Denied</p>

                <div class="message-box">
                    คุณได้เข้าสู่ระบบแล้ว แต่บัญชีของคุณไม่มีสิทธิ์ใช้งานในหน้านี้<br />
                    กรุณากลับไปยังหน้าที่ได้รับอนุญาต หรือเข้าสู่ระบบด้วยบัญชีที่มีสิทธิ์ถูกต้อง
                </div>

                <div class="btn-group-custom">
                    <a asp-controller="Home" asp-action="Index" class="btn-secondary-custom">
                        กลับหน้าหลัก
                    </a>

                    <a asp-controller="Auth" asp-action="Login" class="btn-main">
                        ไปหน้าเข้าสู่ระบบ
                    </a>
                </div>
            </div>

            <!-- footer -->
            <div class="footer-note">
                หากพบว่าควรมีสิทธิ์เข้าใช้งาน กรุณาติดต่อผู้ดูแลระบบ
            </div>
        </div>
    </div>

</body>
</html>