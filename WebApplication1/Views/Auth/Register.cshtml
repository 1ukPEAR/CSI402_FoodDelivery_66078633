@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>

    <!-- Google Font: Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root {
            /* ===== Brand Palette ===== */
            --primary-red: #AA132A;      /* Tabasco Red */
            --secondary-gold: #E9C372;   /* Saffron */
            --secondary-soft: #E0C5A7;   /* Cameo */
            --bg-main: #FDF7EA;          /* Half Colonial White */
            --bg-soft: #F1E2C7;          /* Buttermilk */
            --accent-green: #7E8364;     /* Asparagus Green */
            --navy: #003049;             /* Navy */

            /* ===== UI Tokens ===== */
            --card-bg: #FFFFFF;
            --text-dark: var(--navy);
            --text-muted: #5F6B77;
            --border-soft: var(--secondary-soft);
            --input-bg: #FFFDF8;
            --input-focus: #FFFFFF;
            --focus-ring: rgba(170, 19, 42, 0.08);
            --shadow-main: 0 12px 28px rgba(0, 48, 73, 0.08);
            --shadow-soft: 0 8px 18px rgba(0, 48, 73, 0.05);
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Kanit', sans-serif;
            background: var(--bg-main);
            color: var(--text-dark);
        }

        * {
            box-sizing: border-box;
            font-family: 'Kanit', sans-serif;
        }

        .page {
            position: fixed;
            inset: 0;
            display: flex;
            width: 100vw;
            height: 100vh;
            margin: 0;
            padding: 0;
        }

        /* =========================
           LEFT SIDE
        ========================= */
        .left {
            position: relative;
            flex: 1.08;
            height: 100vh;
            overflow: hidden;
            background: #111;
        }

        .left img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transform: scale(1.01);
            filter: brightness(0.78) contrast(1.02);
        }

        .left::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 48, 73, 0.26);
        }

        .left-content {
            position: absolute;
            left: 56px;
            bottom: 56px;
            z-index: 2;
            color: #FFFFFF;
            max-width: 500px;
        }

        .left-badge {
            display: inline-block;
            padding: 7px 14px;
            margin-bottom: 16px;
            border-radius: 999px;
            background: rgba(233, 195, 114, 0.16);
            border: 1px solid rgba(233, 195, 114, 0.20);
            color: #FFFFFF;
            font-size: 0.82rem;
            font-weight: 500;
            letter-spacing: 0.2px;
        }

        .left-content h2 {
            margin: 0 0 14px;
            font-size: 2.35rem;
            font-weight: 600;
            line-height: 1.22;
            letter-spacing: 0.2px;
        }

        .left-content p {
            margin: 0;
            font-size: 0.98rem;
            line-height: 1.75;
            opacity: 0.95;
            font-weight: 300;
        }

        /* =========================
           RIGHT SIDE
        ========================= */
        .right {
            flex: 0.92;
            height: 100vh;
            background: var(--bg-main);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 28px;
        }

        .form-card {
            width: 100%;
            max-width: 540px;
            height: 90vh;
            background: var(--card-bg);
            border-radius: 22px;
            box-shadow: var(--shadow-main);
            border: 1px solid rgba(224, 197, 167, 0.75);
            overflow: hidden;
            position: relative;
        }

        /* แถบบนเรียบ ๆ ไม่ไล่สี */
        .form-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: var(--secondary-gold);
        }

        .form-scroll {
            height: 100%;
            overflow-y: auto;
            padding: 34px 34px 30px;
        }

        .form-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .form-scroll::-webkit-scrollbar-thumb {
            background: #d7c2a3;
            border-radius: 999px;
        }

        /* =========================
           TYPOGRAPHY
        ========================= */
        .form-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(233, 195, 114, 0.14);
            color: var(--navy);
            font-size: 0.82rem;
            font-weight: 500;
            margin-bottom: 14px;
            border: 1px solid rgba(224, 197, 167, 0.75);
        }

        .form-title {
            font-size: 1.95rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .form-subtitle {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 24px;
            line-height: 1.7;
            font-weight: 300;
        }

        .section-title {
            font-size: 1.02rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 14px;
            letter-spacing: 0.1px;
        }

        .section-divider {
            border: 0;
            height: 1px;
            background: rgba(224, 197, 167, 0.7);
            margin: 22px 0;
        }

        /* =========================
           FORM
        ========================= */
        .input-group-modern {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--navy);
        }

        .form-control {
            min-height: 52px;
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            background: var(--input-bg);
            padding: 12px 16px;
            font-size: 0.95rem;
            font-weight: 400;
            color: var(--navy);
            transition: all 0.2s ease;
            box-shadow: none !important;
        }

        .form-control::placeholder,
        textarea.form-control::placeholder {
            color: #9A8C7C;
            font-weight: 300;
        }

        .form-control:focus {
            border-color: rgba(170, 19, 42, 0.35);
            background: var(--input-focus);
            box-shadow: 0 0 0 4px var(--focus-ring) !important;
        }

        textarea.form-control {
            min-height: 110px;
            resize: vertical;
            padding-top: 14px;
        }

        .btn-register {
            width: 100%;
            margin-top: 24px;
            min-height: 54px;
            border: none;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 600;
            color: #FFFFFF;
            background: var(--primary-red);
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.14);
            transition: all 0.2s ease;
            letter-spacing: 0.2px;
        }

        .btn-register:hover {
            background: #930F23;
            transform: translateY(-1px);
        }

        .btn-register:active {
            transform: translateY(0);
        }

        .login-text {
            margin-top: 18px;
            text-align: center;
            font-size: 0.92rem;
            color: var(--text-muted);
            font-weight: 300;
        }

        .login-text a {
            color: var(--primary-red);
            font-weight: 600;
            text-decoration: none;
        }

        .login-text a:hover {
            text-decoration: underline;
        }

        /* =========================
           RESPONSIVE
        ========================= */
        @@media (max-width: 1200px) {
            .left-content h2 {
                font-size: 2.1rem;
            }

            .left-content {
                left: 40px;
                bottom: 40px;
            }
        }

        @@media (max-width: 992px) {
            .left {
                display: none;
            }

            .right {
                flex: 1;
                width: 100%;
                padding: 16px;
            }

            .form-card {
                max-width: 620px;
                height: 92vh;
                border-radius: 20px;
            }

            .form-scroll {
                padding: 28px 24px 24px;
            }
        }

        @@media (max-width: 576px) {
            html, body {
                overflow: auto;
            }

            .page {
                position: relative;
                display: block;
                height: auto;
                min-height: 100vh;
            }

            .right {
                min-height: 100vh;
                padding: 12px;
            }

            .form-card {
                height: auto;
                min-height: calc(100vh - 24px);
                border-radius: 16px;
            }

            .form-scroll {
                height: auto;
                overflow: visible;
                padding: 24px 18px 22px;
            }

            .form-title {
                font-size: 1.6rem;
            }

            .form-subtitle {
                font-size: 0.9rem;
            }

            .section-title {
                font-size: 0.98rem;
            }

            .row > div {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>

    <div class="page">

        <!-- LEFT IMAGE -->
        <div class="left">
            <img src="~/img/RegisterPic.jpg" alt="Register Cover" />

            <div class="left-content">
                <div class="left-badge">Krua Khwan Chui</div>
                <h2>Create your account and order faster</h2>
                <p>
                    Save your delivery details and enjoy a smoother,
                    more convenient ordering experience every time.
                </p>
            </div>
        </div>

        <!-- RIGHT FORM -->
        <div class="right">
            <div class="form-card">
                <div class="form-scroll">

                    <div class="form-badge">Create Account</div>
                    <div class="form-title">Create an account</div>
                    <div class="form-subtitle">
                        Fill in your information to start shopping with us.
                    </div>

                    <form asp-controller="Auth" asp-action="Register" method="post">

                        <!-- Account Information -->
                        <div class="section-title">Account</div>

                        <div class="input-group-modern">
                            <label class="form-label">Username</label>
                            <input type="text" name="Username" class="form-control" placeholder="Enter your username" />
                        </div>

                        <div class="input-group-modern">
                            <label class="form-label">Password</label>
                            <input type="password" name="Password" class="form-control" placeholder="Enter your password" />
                        </div>

                        <div class="input-group-modern">
                            <label class="form-label">Email</label>
                            <input type="email" name="UserEmail" class="form-control" placeholder="example@email.com" />
                        </div>

                        <div class="input-group-modern">
                            <label class="form-label">Phone</label>
                            <input type="tel" name="UserPhone" class="form-control" placeholder="08x-xxx-xxxx" />
                        </div>

                        <hr class="section-divider" />

                        <!-- Address Information -->
                        <div class="section-title">Delivery Address</div>

                        <div class="input-group-modern">
                            <label class="form-label">ชื่อผู้รับ</label>
                            <input type="text" name="ReceiverName" class="form-control" placeholder="กรอกชื่อผู้รับ" />
                        </div>

                        <div class="input-group-modern">
                            <label class="form-label">เบอร์โทรผู้รับ</label>
                            <input type="tel" name="ReceiverPhone" class="form-control" placeholder="กรอกเบอร์โทรผู้รับ" />
                        </div>

                        <div class="input-group-modern">
                            <label class="form-label">รายละเอียดที่อยู่</label>
                            <textarea name="AddressDetail" class="form-control" placeholder="บ้านเลขที่, หมู่บ้าน, ถนน, ซอย"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">ตำบล</label>
                                <input type="text" name="SubDistrict" class="form-control" placeholder="ตำบล" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">อำเภอ</label>
                                <input type="text" name="District" class="form-control" placeholder="อำเภอ" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label">จังหวัด</label>
                                <input type="text" name="Province" class="form-control" placeholder="จังหวัด" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-register">
                            Register
                        </button>

                        <div class="login-text">
                            Already have an account?
                            <a asp-controller="Auth" asp-action="Login">Sign in</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>

    </div>

</body>
</html>