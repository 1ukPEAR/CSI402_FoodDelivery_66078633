@model WebApplication1.FoodViewModels.AuthViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <!-- Google Font: Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Boxicons -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <style>
        :root {
            /* ===== Brand Palette ===== */
            --primary-red: #AA132A;      /* Tabasco Red */
            --secondary-soft: #E0C5A7;   /* Cameo */
            --bg-main: #FDF7EA;          /* Half Colonial White */
            --navy: #003049;             /* Navy */

            /* ===== UI Tokens ===== */
            --card-bg: #FFFFFF;
            --text-dark: var(--navy);
            --text-muted: #5F6B77;
            --border-soft: var(--secondary-soft);
            --input-bg: #FFFDF8;
            --focus-ring: rgba(170, 19, 42, 0.08);
            --shadow-main: 0 14px 32px rgba(0, 48, 73, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            font-family: 'Kanit', sans-serif;
            background: var(--bg-main);
            color: var(--text-dark);
        }

        .login-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 500px;
            border-radius: 22px;
            overflow: hidden;
            background: var(--card-bg);
            box-shadow: var(--shadow-main);
            border: 1px solid rgba(224, 197, 167, 0.75);
        }

        .cover-wrap {
            position: relative;
            height: 160px;
            overflow: hidden;
            background: #111;
        }

        .cover-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: brightness(0.82) contrast(1.02);
        }

        .cover-wrap::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 48, 73, 0.18);
        }

        .card-body-custom {
            padding: 24px 24px 18px;
        }

        .brand-block {
            text-align: center;
            margin-bottom: 18px;
        }

        .brand-title {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--navy);
            line-height: 1.2;
        }

        .brand-subtitle {
            margin: 6px 0 0;
            color: var(--text-muted);
            font-size: 0.92rem;
            font-weight: 300;
            line-height: 1.4;
        }

        .form-label {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .form-control {
            min-height: 46px;
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            background: var(--input-bg);
            font-size: 0.95rem;
            color: var(--navy);
            box-shadow: none !important;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: rgba(170, 19, 42, 0.35);
            background: #fff;
            box-shadow: 0 0 0 4px var(--focus-ring) !important;
        }

        .form-control.username-input {
            padding: 10px 14px;
        }

        .password-wrap {
            position: relative;
        }

        .password-input {
            padding: 10px 46px 10px 14px;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #7b6f62;
            font-size: 20px;
            line-height: 1;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toggle-password:hover {
            color: var(--primary-red);
        }

        .field-validation-error {
            color: var(--primary-red);
            font-size: 0.82rem;
            margin-top: 4px;
            display: block;
        }

        .forgot-wrap {
            text-align: end;
            margin-top: -2px;
            margin-bottom: 16px;
        }

        .forgot-link {
            font-size: 0.84rem;
            color: var(--primary-red);
            text-decoration: none;
            font-weight: 500;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .btn-login {
            width: 100%;
            min-height: 48px;
            border: none;
            border-radius: 14px;
            background: var(--primary-red);
            color: #fff;
            font-size: 0.98rem;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.14);
        }

        .btn-login:hover {
            background: #930F23;
            transform: translateY(-1px);
            color: #fff;
        }

        .register-link-wrap {
            text-align: center;
            padding: 14px 16px 18px;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 300;
            border-top: 1px solid rgba(224, 197, 167, 0.55);
        }

        .register-link {
            color: var(--navy);
            font-weight: 600;
            text-decoration: none;
        }

        .register-link:hover {
            text-decoration: underline;
        }

        .validation-summary-errors,
        .text-danger.validation-summary-errors {
            font-size: 0.85rem;
            margin-bottom: 12px;
        }

        @@media (max-width: 576px) {
            .login-page {
                padding: 14px;
            }

            .login-card {
                border-radius: 18px;
            }

            .cover-wrap {
                height: 145px;
            }

            .card-body-custom {
                padding: 20px 18px 16px;
            }

            .brand-title {
                font-size: 1.55rem;
            }

            .brand-subtitle {
                font-size: 0.88rem;
            }
        }
    </style>
</head>
<body>

    <div class="login-page">
        <div class="login-card">

            <!-- รูปด้านบนแบบเดิม -->
            <div class="cover-wrap">
                <img src="~/img/RegisterPic.jpg" alt="Login Cover" />
            </div>

            <!-- เนื้อหาการ์ด -->
            <div class="card-body-custom">
                <div class="brand-block">
                    <h3 class="brand-title">Krua Khwan Chui</h3>
                    <p class="brand-subtitle">Your Meal Starts Here</p>
                </div>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input type="text" asp-for="Username" class="form-control username-input" placeholder="Enter your username" />
                        <span asp-validation-for="Username" class="field-validation-error"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-wrap">
                            <input type="password" asp-for="Password" id="loginPassword" class="form-control password-input" placeholder="Enter your password" />
                            <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)">
                                <i class="bx bx-hide"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <!-- Forgot Password -->
                    <div class="forgot-wrap">
                        <a asp-controller="Auth"
                           asp-action="ForgotPassword"
                           class="forgot-link">
                            Forgot Password?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-login">
                        Login
                    </button>
                </form>
            </div>

            <!-- ลิงก์สมัครสมาชิกแบบเดิม -->
            <div class="register-link-wrap">
                Don't have an account?
                <a asp-controller="Auth"
                   asp-action="Register"
                   class="register-link">
                    Create one
                </a>
            </div>
        </div>
    </div>

    <!-- Validation scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bx-hide');
                icon.classList.add('bx-show');
            } else {
                input.type = 'password';
                icon.classList.remove('bx-show');
                icon.classList.add('bx-hide');
            }
        }
    </script>
</body>
</html>