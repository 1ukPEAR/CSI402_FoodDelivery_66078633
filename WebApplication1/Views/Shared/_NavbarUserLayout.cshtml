@using System.Text.Json
@using System.Security.Claims
@using WebApplication1.FoodViewModels
@using WebApplication1.Models.db
@inject FooddeliverydbContext _db

<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CSI402_66078633</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CSI402_66078633.styles.css" asp-append-version="true" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <!-- Prompt Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-red: #AA132A;
            --secondary-soft: #E0C5A7;
            --bg-main: #FDF7EA;
            --navy: #003049;
            --text-muted: #6B7280;
            --soft-line: rgba(224, 197, 167, 0.65);
            --soft-shadow: 0 8px 24px rgba(0, 48, 73, 0.06);
            --soft-shadow-lg: 0 14px 36px rgba(0, 48, 73, 0.10);
            --active-green: #7E8364;
        }

        html, body {
            background: var(--bg-main);
            color: var(--navy);
            font-family: 'Prompt', sans-serif;
        }

        /* FORCE PROMPT ทั้งหน้า */
        html, body,
        .navbar, .restaurant-navbar,
        .menu-link,
        .user-chip, .user-name, .user-status,
        .point-chip, .point-label, .point-value,
        .btn, .dropdown-item,
        .modal-content, .modal-title,
        .form-control, .form-label,
        .alert,
        h1, h2, h3, h4, h5, h6,
        p, span, div, a, button, input, textarea, label {
            font-family: 'Prompt', sans-serif !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 700;
            letter-spacing: -0.2px;
        }

        /* ===================== NAVBAR ===================== */
        .restaurant-navbar {
            background: rgba(253, 247, 234, 0.97);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--soft-line);
            box-shadow: 0 4px 18px rgba(0, 48, 73, 0.04);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .nav-grid {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 18px;
        }

        /* LEFT */
        .nav-left {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            min-width: 0;
        }

        .logo-img {
            height: 54px;
            width: auto;
            object-fit: contain;
            flex-shrink: 0;
        }

        /* CENTER */
        .nav-center {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .menu-wrapper {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: nowrap;
            background: rgba(255, 255, 255, 0.78);
            border: 1px solid rgba(224, 197, 167, 0.65);
            border-radius: 999px;
            padding: 6px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
        }

        .menu-link {
            color: var(--navy);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            padding: 10px 18px;
            border-radius: 999px;
            transition: all 0.22s ease;
            white-space: nowrap;
            background: transparent;
            border: 1px solid transparent;
        }

        .menu-link:hover {
            background: #fff;
            color: var(--primary-red);
            border-color: rgba(224, 197, 167, 0.85);
            box-shadow: 0 6px 16px rgba(0, 48, 73, 0.04);
        }

        .menu-link.active-nav {
            background: #fff;
            color: var(--primary-red);
            border-color: rgba(170, 19, 42, 0.12);
            box-shadow: 0 8px 18px rgba(170, 19, 42, 0.07);
            font-weight: 600;
        }

        /* RIGHT */
        .nav-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            min-width: 0;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1px solid rgba(224, 197, 167, 0.75);
            border-radius: 16px;
            padding: 8px 12px;
            box-shadow: 0 6px 16px rgba(0, 48, 73, 0.04);
            min-height: 46px;
            max-width: 220px;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            background: rgba(170, 19, 42, 0.08);
            color: var(--primary-red);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .user-meta {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            min-width: 0;
        }

        .user-name {
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--navy);
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--active-green);
            margin-top: 2px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--active-green);
            display: inline-block;
        }

        .point-chip {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 98px;
            height: 46px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid rgba(224, 197, 167, 0.75);
            box-shadow: 0 6px 16px rgba(0, 48, 73, 0.04);
            text-decoration: none;
            padding: 4px 10px;
        }

        .point-label {
            font-size: 0.68rem;
            color: #8a8a8a;
            line-height: 1;
        }

        .point-value {
            font-size: 1rem;
            font-weight: 700;
            color: #2563eb;
            line-height: 1.1;
            margin-top: 3px;
        }

        .nav-icon-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: #fff;
            color: var(--navy);
            text-decoration: none;
            font-size: 22px;
            transition: all 0.22s ease;
            border: 1px solid rgba(224, 197, 167, 0.75);
            box-shadow: 0 6px 16px rgba(0, 48, 73, 0.04);
        }

        .nav-icon-btn:hover {
            background: #fff;
            color: var(--primary-red);
            border-color: rgba(170, 19, 42, 0.18);
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(0, 48, 73, 0.08);
        }

        .nav-icon-btn:focus,
        .nav-icon-btn:active {
            box-shadow: none;
            outline: none;
        }

        .cart-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--primary-red);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            min-width: 20px;
            height: 20px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 2px solid #fff;
        }

        .dropdown-toggle::after {
            display: none !important;
        }

        .profile-dropdown-menu {
            min-width: 230px;
            border: 1px solid rgba(224, 197, 167, 0.55);
            border-radius: 18px;
            padding: 8px;
            box-shadow: var(--soft-shadow-lg);
            margin-top: 10px !important;
            background: #fff;
        }

        .profile-dropdown-menu .dropdown-item {
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 500;
            color: var(--navy);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .profile-dropdown-menu .dropdown-item:hover {
            background: #fdf7ea;
            color: var(--primary-red);
        }

        .profile-dropdown-menu .dropdown-item.text-danger {
            color: var(--primary-red) !important;
        }

        .profile-dropdown-menu .dropdown-item.text-danger:hover {
            background: #fff4f5;
            color: #8f1023 !important;
        }

        .profile-dropdown-menu .dropdown-divider {
            margin: 6px 0;
            border-top-color: rgba(224, 197, 167, 0.55);
        }

        .logout-form-inline {
            margin: 0;
            padding: 0;
        }

        .logout-btn-clean {
            border: 0;
            background: transparent;
            width: 100%;
            text-align: left;
        }

        .page-content {
            margin-top: 24px;
            margin-bottom: 28px;
        }

        .modal-content {
            border-radius: 24px !important;
            border: 1px solid rgba(224, 197, 167, 0.45) !important;
            box-shadow: var(--soft-shadow-lg) !important;
        }

        .modal .form-label {
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .modal .form-control,
        .modal textarea {
            border-radius: 14px;
            border: 1px solid rgba(224, 197, 167, 0.9);
            background: #fffdfa;
            min-height: 44px;
            box-shadow: none !important;
        }

        .modal .form-control:focus,
        .modal textarea:focus {
            border-color: rgba(170, 19, 42, 0.25);
            box-shadow: 0 0 0 4px rgba(170, 19, 42, 0.06) !important;
        }

        .address-card-manage {
            border: 1px solid rgba(224, 197, 167, 0.6);
            border-radius: 18px;
            padding: 14px;
            margin-bottom: 12px;
            background: #fff;
            box-shadow: 0 6px 16px rgba(0, 48, 73, 0.03);
        }

        .btn-soft {
            border-radius: 12px;
            border: 1px solid rgba(224, 197, 167, 0.75);
            background: #fff;
            color: var(--navy);
            font-weight: 500;
            padding: 8px 14px;
        }

        .btn-soft:hover {
            background: #fdf7ea;
            color: var(--primary-red);
        }

        .btn-brand {
            border-radius: 12px;
            border: none;
            background: var(--primary-red);
            color: #fff;
            font-weight: 600;
            padding: 8px 16px;
        }

        .btn-brand:hover {
            background: #8f1023;
            color: #fff;
        }

        .btn-outline-brand {
            border-radius: 12px;
            border: 1px solid rgba(170, 19, 42, 0.18);
            background: #fff;
            color: var(--primary-red);
            font-weight: 500;
            padding: 8px 14px;
        }

        .btn-outline-brand:hover {
            background: #fff4f5;
            color: #8f1023;
        }

        @@media (max-width: 1199.98px) {
            .nav-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .nav-left,
            .nav-center,
            .nav-right {
                justify-content: center;
            }

            .user-chip {
                max-width: none;
            }
        }

        @@media (max-width: 767.98px) {
            .menu-wrapper {
                flex-wrap: wrap;
                border-radius: 18px;
            }

            .menu-link {
                width: 100%;
                text-align: center;
            }

            .nav-right {
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    @{
        // ===== CART =====
        var cartJson = Context.Session.GetString("Cart");
        var cartItems = string.IsNullOrEmpty(cartJson)
            ? new List<CartItemViewModel>()
            : JsonSerializer.Deserialize<List<CartItemViewModel>>(cartJson) ?? new List<CartItemViewModel>();

        var cartCount = cartItems.Sum(x => x.Quantity);

        // ===== CURRENT USER FROM CLAIMS + DB =====
        var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var currentUser = !string.IsNullOrWhiteSpace(currentUserId)
            ? _db.FoodUsers.FirstOrDefault(u => u.UserId == currentUserId)
            : null;

        var displayUserName = currentUser?.UserName ?? "Guest";
        var displayStatus = (currentUser?.UserStatus ?? 0) == 1 ? "Active" : "Inactive";
        var loyaltyPoints = currentUser?.LoyaltyPoints ?? 0;

        // ===== ACTIVE MENU =====
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool isMenuPage = currentController == "Menu" && currentAction == "MenuUser";
        bool isOrderStatusPage = currentController == "Order" && currentAction == "OrderStatus";
        bool isHistoryPage = currentController == "Order" && currentAction == "HistoryUser";
    }

    <nav class="container-fluid restaurant-navbar">
        <div class="container">
            <div class="nav-grid">

                <!-- LEFT : LOGO -->
                <div class="nav-left">
                    <img src="~/img/ครัว.png" class="logo-img" alt="Logo" />
                </div>

                <!-- CENTER : MENU (ไม่มีไอคอน) -->
                <div class="nav-center">
                    <div class="menu-wrapper">
                        <a class="menu-link @(isMenuPage ? "active-nav" : "")" asp-controller="Menu" asp-action="MenuUser">
                            เมนูอาหาร
                        </a>

                        <a class="menu-link @(isOrderStatusPage ? "active-nav" : "")" asp-controller="Order" asp-action="OrderStatus">
                            สถานะอาหาร
                        </a>

                        <a class="menu-link @(isHistoryPage ? "active-nav" : "")" asp-controller="Order" asp-action="HistoryUser">
                            ประวัติสั่งอาหาร
                        </a>
                    </div>
                </div>

                <!-- RIGHT : USER + STATUS + POINT + CART + SETTING -->
                <div class="nav-right">

                    <!-- USER NAME + ACTIVE STATUS -->
                    <div class="user-chip">
                        <div class="user-avatar">
                            <i class='bx bx-user'></i>
                        </div>
                        <div class="user-meta">
                            <div class="user-name" title="@displayUserName">@displayUserName</div>
                            <div class="user-status">
                                <span class="status-dot"></span>
                                <span>@displayStatus</span>
                            </div>
                        </div>
                    </div>

                    <!-- POINT / PRO -->
                    <div class="point-chip" title="แต้มสะสมปัจจุบัน">
                        <div class="point-label">แต้มสะสม</div>
                        <div class="point-value">@loyaltyPoints แต้ม</div>
                    </div>

                    <!-- CART -->
                    <a class="nav-icon-btn" href="javascript:void(0);" id="openCartPopupBtn" title="ตะกร้าสินค้า">
                        <i class='bx bx-cart'></i>
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge">@cartCount</span>
                        }
                    </a>

                    <!-- SETTINGS / PROFILE -->
                    <div class="dropdown d-inline-block">
                        <button class="nav-icon-btn dropdown-toggle"
                                type="button"
                                id="profileDropdownBtn"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                title="ตั้งค่าบัญชี">
                            <i class='bx bx-cog'></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu" aria-labelledby="profileDropdownBtn">
                            <li>
                                <button type="button" class="dropdown-item" id="openProfileModalBtn">
                                    โปรไฟล์ของฉัน
                                </button>
                            </li>

                            <li>
                                <button type="button" class="dropdown-item" id="openAddressModalBtn">
                                    จัดการที่อยู่
                                </button>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger logout-btn-clean">
                                        ออกจากระบบ
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </nav>

    <div class="container page-content">
        @RenderBody()
    </div>

    <!-- Cart Popup Modal -->
    <div class="modal fade" id="cartPopupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <div class="modal-header border-0">
                    <h4 class="modal-title fw-bold">ตะกร้าของคุณ</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" id="cartPopupContent">
                    <div class="text-center py-4 text-muted">กำลังโหลด...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile Modal -->
    <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold">โปรไฟล์ของฉัน</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-3">
                    <div id="profileAlertArea"></div>

                    <form id="profileForm">
                        <div class="mb-3">
                            <label class="form-label">ชื่อผู้ใช้</label>
                            <input type="text" class="form-control" id="profileUserName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">อีเมล</label>
                            <input type="email" class="form-control" id="profileUserEmail" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">เบอร์โทร</label>
                            <input type="text" class="form-control" id="profileUserPhone" />
                        </div>

                        <div class="small text-muted">
                            * หากต้องการเปลี่ยนรหัสผ่าน ให้ทำผ่านหน้าล็อกอิน
                        </div>
                    </form>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">ปิด</button>
                    <button type="button" class="btn btn-brand" id="saveProfileBtn">บันทึกข้อมูล</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Address Modal -->
    <div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <div class="modal-header border-0 pb-0">
                    <h4 class="modal-title fw-bold">จัดการที่อยู่</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-3">
                    <div id="addressAlertArea"></div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="fw-semibold">รายการที่อยู่ที่บันทึกไว้</div>
                        <button type="button" class="btn btn-outline-brand" id="toggleAddAddressFormBtn">
                            + เพิ่มที่อยู่ใหม่
                        </button>
                    </div>

                    <div id="addressListArea" class="mb-4">
                        <div class="text-center py-3 text-muted">กำลังโหลด...</div>
                    </div>

                    <div id="addAddressFormWrap" class="border rounded-4 p-3 d-none bg-light">
                        <input type="hidden" id="addressEditId" value="" />

                        <h6 class="fw-bold mb-3" id="addressFormTitle">เพิ่มที่อยู่ใหม่</h6>

                        <form id="addAddressForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">ชื่อผู้รับ</label>
                                    <input type="text" class="form-control" id="addrUserName" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">เบอร์โทรผู้รับ</label>
                                    <input type="text" class="form-control" id="addrReceiverPhone" required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">รายละเอียดที่อยู่</label>
                                    <textarea class="form-control" id="addrAddressDetail" rows="2" required></textarea>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">ตำบล / แขวง</label>
                                    <input type="text" class="form-control" id="addrSubDistrict" required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">อำเภอ / เขต</label>
                                    <input type="text" class="form-control" id="addrDistrict" required />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">จังหวัด</label>
                                    <input type="text" class="form-control" id="addrProvince" required />
                                </div>
                            </div>
                        </form>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-soft" id="cancelAddAddressBtn">ยกเลิก</button>
                            <button type="button" class="btn btn-brand" id="saveAddressBtn">บันทึกที่อยู่</button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const openCartPopupBtn = document.getElementById("openCartPopupBtn");
            const cartPopupContent = document.getElementById("cartPopupContent");
            const cartPopupModalEl = document.getElementById("cartPopupModal");

            const openProfileModalBtn = document.getElementById("openProfileModalBtn");
            const profileModalEl = document.getElementById("profileModal");
            const saveProfileBtn = document.getElementById("saveProfileBtn");

            const openAddressModalBtn = document.getElementById("openAddressModalBtn");
            const addressModalEl = document.getElementById("addressModal");
            const toggleAddAddressFormBtn = document.getElementById("toggleAddAddressFormBtn");
            const addAddressFormWrap = document.getElementById("addAddressFormWrap");
            const cancelAddAddressBtn = document.getElementById("cancelAddAddressBtn");
            const saveAddressBtn = document.getElementById("saveAddressBtn");

            const profileAlertArea = document.getElementById("profileAlertArea");
            const addressAlertArea = document.getElementById("addressAlertArea");
            const addressListArea = document.getElementById("addressListArea");

            const addressEditId = document.getElementById("addressEditId");
            const addressFormTitle = document.getElementById("addressFormTitle");

            const addrUserName = document.getElementById("addrUserName");
            const addrReceiverPhone = document.getElementById("addrReceiverPhone");
            const addrAddressDetail = document.getElementById("addrAddressDetail");
            const addrSubDistrict = document.getElementById("addrSubDistrict");
            const addrDistrict = document.getElementById("addrDistrict");
            const addrProvince = document.getElementById("addrProvince");

            const profileModal = profileModalEl ? new bootstrap.Modal(profileModalEl) : null;
            const addressModal = addressModalEl ? new bootstrap.Modal(addressModalEl) : null;
            const cartPopupModal = cartPopupModalEl ? new bootstrap.Modal(cartPopupModalEl) : null;

            function showAlert(target, type, message) {
                if (!target) return;
                target.innerHTML = `<div class="alert alert-${type} rounded-4 py-2 px-3 mb-3">${message}</div>`;
            }

            function clearAlert(target) {
                if (!target) return;
                target.innerHTML = "";
            }

            function escapeHtml(text) {
                if (text == null) return "";
                return text
                    .toString()
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function jsSafe(text) {
                if (text == null) return "";
                return text
                    .toString()
                    .replace(/\\/g, "\\\\")
                    .replace(/'/g, "\\'")
                    .replace(/\r/g, " ")
                    .replace(/\n/g, " ");
            }

            // CART POPUP
            if (openCartPopupBtn && cartPopupContent && cartPopupModal) {
                openCartPopupBtn.addEventListener("click", function () {
                    cartPopupContent.innerHTML = '<div class="text-center py-4 text-muted">กำลังโหลด...</div>';

                    fetch('/Cart/CartPopup')
                        .then(response => response.text())
                        .then(html => {
                            cartPopupContent.innerHTML = html;
                            cartPopupModal.show();
                        })
                        .catch(() => {
                            cartPopupContent.innerHTML = '<div class="text-danger text-center py-4">โหลดตะกร้าไม่สำเร็จ</div>';
                            cartPopupModal.show();
                        });
                });
            }

            // PROFILE
            function loadProfile() {
                clearAlert(profileAlertArea);

                fetch('/User/GetProfile')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            showAlert(profileAlertArea, 'danger', data.message || 'โหลดข้อมูลโปรไฟล์ไม่สำเร็จ');
                            return;
                        }

                        document.getElementById('profileUserName').value = data.userName || '';
                        document.getElementById('profileUserEmail').value = data.userEmail || '';
                        document.getElementById('profileUserPhone').value = data.userPhone || '';
                    })
                    .catch(() => {
                        showAlert(profileAlertArea, 'danger', 'โหลดข้อมูลโปรไฟล์ไม่สำเร็จ');
                    });
            }

            if (openProfileModalBtn && profileModal) {
                openProfileModalBtn.addEventListener("click", function () {
                    profileModal.show();
                    loadProfile();
                });
            }

            if (saveProfileBtn) {
                saveProfileBtn.addEventListener("click", function () {
                    clearAlert(profileAlertArea);

                    const payload = {
                        userName: document.getElementById('profileUserName').value.trim(),
                        userEmail: document.getElementById('profileUserEmail').value.trim(),
                        userPhone: document.getElementById('profileUserPhone').value.trim()
                    };

                    fetch('/User/UpdateProfileAjax', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showAlert(profileAlertArea, 'success', data.message || 'บันทึกข้อมูลสำเร็จ');

                            // อัปเดตชื่อบน navbar แบบไม่ต้องรีเฟรช
                            const nameEl = document.querySelector('.user-name');
                            if (nameEl) {
                                nameEl.textContent = payload.userName || 'Guest';
                                nameEl.title = payload.userName || 'Guest';
                            }
                        } else {
                            showAlert(profileAlertArea, 'danger', data.message || 'บันทึกข้อมูลไม่สำเร็จ');
                        }
                    })
                    .catch(() => {
                        showAlert(profileAlertArea, 'danger', 'บันทึกข้อมูลไม่สำเร็จ');
                    });
                });
            }

            // ADDRESS
            function clearAddressForm() {
                if (addrUserName) addrUserName.value = '';
                if (addrReceiverPhone) addrReceiverPhone.value = '';
                if (addrAddressDetail) addrAddressDetail.value = '';
                if (addrSubDistrict) addrSubDistrict.value = '';
                if (addrDistrict) addrDistrict.value = '';
                if (addrProvince) addrProvince.value = '';
            }

            function resetAddressForm() {
                if (addressEditId) addressEditId.value = '';
                if (addressFormTitle) addressFormTitle.textContent = 'เพิ่มที่อยู่ใหม่';
                if (saveAddressBtn) saveAddressBtn.textContent = 'บันทึกที่อยู่';

                clearAddressForm();
            }

            function openAddAddressForm() {
                resetAddressForm();
                if (addAddressFormWrap) addAddressFormWrap.classList.remove('d-none');
            }

            function closeAddAddressForm() {
                if (addAddressFormWrap) addAddressFormWrap.classList.add('d-none');
                resetAddressForm();
            }

            window.editAddressFromPopup = function (addressId, userName, receiverPhone, addressDetail, subDistrict, district, province) {
                clearAlert(addressAlertArea);

                if (addressEditId) addressEditId.value = addressId || '';

                if (addrUserName) addrUserName.value = userName || '';
                if (addrReceiverPhone) addrReceiverPhone.value = receiverPhone || '';
                if (addrAddressDetail) addrAddressDetail.value = addressDetail || '';
                if (addrSubDistrict) addrSubDistrict.value = subDistrict || '';
                if (addrDistrict) addrDistrict.value = district || '';
                if (addrProvince) addrProvince.value = province || '';

                if (addressFormTitle) addressFormTitle.textContent = 'แก้ไขที่อยู่';
                if (saveAddressBtn) saveAddressBtn.textContent = 'บันทึกการแก้ไข';

                if (addAddressFormWrap) {
                    addAddressFormWrap.classList.remove('d-none');
                }
            };

            window.deleteAddressFromPopup = function (addressId) {
                if (!addressId) return;

                const ok = confirm('ต้องการลบที่อยู่นี้ใช่หรือไม่?');
                if (!ok) return;

                clearAlert(addressAlertArea);

                fetch('/User/DeleteAddressAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ addressId: addressId })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showAlert(addressAlertArea, 'success', data.message || 'ลบที่อยู่เรียบร้อยแล้ว');
                        closeAddAddressForm();
                        loadAddresses();
                    } else {
                        showAlert(addressAlertArea, 'danger', data.message || 'ลบที่อยู่ไม่สำเร็จ');
                    }
                })
                .catch(() => {
                    showAlert(addressAlertArea, 'danger', 'ลบที่อยู่ไม่สำเร็จ');
                });
            };

            function renderAddressList(addresses) {
                if (!addresses || addresses.length === 0) {
                    addressListArea.innerHTML = '<div class="text-muted text-center py-3">ยังไม่มีที่อยู่ที่บันทึกไว้</div>';
                    return;
                }

                let html = '';
                addresses.forEach(addr => {
                    html += `
                        <div class="address-card-manage">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div class="flex-grow-1">
                                    <div class="fw-bold">${escapeHtml(addr.userName)} (${escapeHtml(addr.receiverPhone)})</div>
                                    <div class="text-muted small mt-1">
                                        ${escapeHtml(addr.addressDetail)} ต.${escapeHtml(addr.subDistrict)} อ.${escapeHtml(addr.district)} จ.${escapeHtml(addr.province)}
                                    </div>
                                    <div class="small text-secondary mt-1">
                                        รหัสที่อยู่: ${escapeHtml(addr.addressId)}
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-brand"
                                            onclick="editAddressFromPopup(
                                                '${jsSafe(addr.addressId)}',
                                                '${jsSafe(addr.userName)}',
                                                '${jsSafe(addr.receiverPhone)}',
                                                '${jsSafe(addr.addressDetail)}',
                                                '${jsSafe(addr.subDistrict)}',
                                                '${jsSafe(addr.district)}',
                                                '${jsSafe(addr.province)}'
                                            )">
                                        แก้ไข
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger rounded-3"
                                            onclick="deleteAddressFromPopup('${jsSafe(addr.addressId)}')">
                                        ลบ
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                addressListArea.innerHTML = html;
            }

            function loadAddresses() {
                clearAlert(addressAlertArea);
                addressListArea.innerHTML = '<div class="text-center py-3 text-muted">กำลังโหลด...</div>';

                fetch('/User/GetAddresses')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            showAlert(addressAlertArea, 'danger', data.message || 'โหลดที่อยู่ไม่สำเร็จ');
                            addressListArea.innerHTML = '';
                            return;
                        }

                        renderAddressList(data.addresses || []);
                    })
                    .catch(() => {
                        showAlert(addressAlertArea, 'danger', 'โหลดที่อยู่ไม่สำเร็จ');
                        addressListArea.innerHTML = '';
                    });
            }

            if (openAddressModalBtn && addressModal) {
                openAddressModalBtn.addEventListener("click", function () {
                    addressModal.show();
                    closeAddAddressForm();
                    loadAddresses();
                });
            }

            if (toggleAddAddressFormBtn) {
                toggleAddAddressFormBtn.addEventListener("click", function () {
                    if (addAddressFormWrap.classList.contains('d-none')) {
                        openAddAddressForm();
                    } else {
                        closeAddAddressForm();
                    }
                });
            }

            if (cancelAddAddressBtn) {
                cancelAddAddressBtn.addEventListener("click", function () {
                    closeAddAddressForm();
                });
            }

            if (saveAddressBtn) {
                saveAddressBtn.addEventListener("click", function () {
                    clearAlert(addressAlertArea);

                    const payload = {
                        addressId: addressEditId ? addressEditId.value.trim() : '',
                        userName: addrUserName ? addrUserName.value.trim() : '',
                        receiverPhone: addrReceiverPhone ? addrReceiverPhone.value.trim() : '',
                        addressDetail: addrAddressDetail ? addrAddressDetail.value.trim() : '',
                        subDistrict: addrSubDistrict ? addrSubDistrict.value.trim() : '',
                        district: addrDistrict ? addrDistrict.value.trim() : '',
                        province: addrProvince ? addrProvince.value.trim() : ''
                    };

                    if (!payload.userName || !payload.receiverPhone || !payload.addressDetail || !payload.subDistrict || !payload.district || !payload.province) {
                        showAlert(addressAlertArea, 'danger', 'กรุณากรอกข้อมูลที่อยู่ให้ครบ');
                        return;
                    }

                    const isEditMode = !!payload.addressId;
                    const url = isEditMode ? '/User/UpdateAddressAjax' : '/User/AddAddressAjax';

                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showAlert(addressAlertArea, 'success', data.message || (isEditMode ? 'แก้ไขที่อยู่สำเร็จ' : 'บันทึกที่อยู่สำเร็จ'));
                            closeAddAddressForm();
                            loadAddresses();
                        } else {
                            showAlert(addressAlertArea, 'danger', data.message || (isEditMode ? 'แก้ไขที่อยู่ไม่สำเร็จ' : 'บันทึกที่อยู่ไม่สำเร็จ'));
                        }
                    })
                    .catch(() => {
                        showAlert(addressAlertArea, 'danger', isEditMode ? 'แก้ไขที่อยู่ไม่สำเร็จ' : 'บันทึกที่อยู่ไม่สำเร็จ');
                    });
                });
            }
        });
    </script>

</body>
</html>