<script>
document.addEventListener("DOMContentLoaded", function () {

    // =========================
    // CREATE DISCOUNT TYPE
    // =========================
    const createDiscountType = document.querySelector(".create-discount-type");
    const createDiscountValue = document.querySelector(".create-discount-value");
    const createDiscountLabel = document.querySelector(".create-discount-label");
    const createDiscountHelp = document.querySelector(".create-discount-help");

    function updateCreateDiscountUI() {
        if (!createDiscountType || !createDiscountValue || !createDiscountLabel || !createDiscountHelp) return;

        const type = createDiscountType.value;

        if (type === "AMOUNT") {
            createDiscountLabel.innerHTML = 'ค่าส่วนลด (บาท) <span class="text-danger">*</span>';
            createDiscountValue.max = "";
            createDiscountValue.min = "0.01";
            createDiscountHelp.textContent = "ระบุจำนวนเงินที่ต้องการลด เช่น 50 บาท";
        } else {
            createDiscountLabel.innerHTML = 'ค่าส่วนลด (%) <span class="text-danger">*</span>';
            createDiscountValue.max = "100";
            createDiscountValue.min = "0.01";
            createDiscountHelp.textContent = "ถ้าเลือกเปอร์เซ็นต์ ระบบจะจำกัดไม่เกิน 100%";
        }
    }

    if (createDiscountType) {
        createDiscountType.addEventListener("change", updateCreateDiscountUI);
        updateCreateDiscountUI();
    }

    // =========================
    // EDIT DISCOUNT TYPE
    // =========================
    const editDiscountType = document.getElementById("editDiscountType");
    const editDiscountValue = document.getElementById("editDiscountValue");
    const editDiscountLabel = document.querySelector(".edit-discount-label");
    const editDiscountHelp = document.querySelector(".edit-discount-help");

    function updateEditDiscountUI() {
        if (!editDiscountType || !editDiscountValue || !editDiscountLabel || !editDiscountHelp) return;

        const type = editDiscountType.value;

        if (type === "AMOUNT") {
            editDiscountLabel.innerHTML = 'ค่าส่วนลด (บาท) <span class="text-danger">*</span>';
            editDiscountValue.max = "";
            editDiscountValue.min = "0.01";
            editDiscountHelp.textContent = "ระบุจำนวนเงินที่ต้องการลด เช่น 50 บาท";
        } else {
            editDiscountLabel.innerHTML = 'ค่าส่วนลด (%) <span class="text-danger">*</span>';
            editDiscountValue.max = "100";
            editDiscountValue.min = "0.01";
            editDiscountHelp.textContent = "ถ้าเลือกเปอร์เซ็นต์ ระบบจะจำกัดไม่เกิน 100%";
        }
    }

    if (editDiscountType) {
        editDiscountType.addEventListener("change", updateEditDiscountUI);
        updateEditDiscountUI();
    }

    // =========================
    // CREATE MILESTONE TOGGLE
    // =========================
    const createIsMilestone = document.querySelector(".create-is-milestone");
    const createRequiredOrderCount = document.querySelector(".create-required-order-count");

    function toggleCreateMilestoneFields() {
        if (!createIsMilestone || !createRequiredOrderCount) return;

        if (createIsMilestone.checked) {
            createRequiredOrderCount.disabled = false;
            createRequiredOrderCount.required = true;
        } else {
            createRequiredOrderCount.disabled = true;
            createRequiredOrderCount.required = false;
            createRequiredOrderCount.value = "";
        }
    }

    if (createIsMilestone) {
        createIsMilestone.addEventListener("change", toggleCreateMilestoneFields);
        toggleCreateMilestoneFields();
    }

    // =========================
    // EDIT MILESTONE TOGGLE
    // =========================
    const editPromotionId = document.getElementById("editPromotionId");
    const editPromotionName = document.getElementById("editPromotionName");
    const editDescription = document.getElementById("editDescriptionPro");
    const editStartDate = document.getElementById("editStartDatePromotion");
    const editEndDate = document.getElementById("editEndDatePromotion");
    const editMaxUser = document.getElementById("editMaxUsePerUser");
    const editMaxOrder = document.getElementById("editMaxUsePerOrder");
    const editIsMilestone = document.getElementById("editIsMilestonePromotion");
    const editRequiredOrderCount = document.getElementById("editRequiredOrderCount");

    function toggleEditMilestoneFields() {
        if (!editIsMilestone || !editRequiredOrderCount) return;

        if (editIsMilestone.checked) {
            editRequiredOrderCount.disabled = false;
            editRequiredOrderCount.required = true;
        } else {
            editRequiredOrderCount.disabled = true;
            editRequiredOrderCount.required = false;
            editRequiredOrderCount.value = "";
        }
    }

    if (editIsMilestone) {
        editIsMilestone.addEventListener("change", toggleEditMilestoneFields);
        toggleEditMilestoneFields();
    }

    // =========================
    // EDIT BUTTON CLICK
    // =========================
    document.querySelectorAll(".btn-edit-promo").forEach(btn => {
        btn.addEventListener("click", function () {
            const promotionId = this.dataset.promotionId || "";
            const promotionName = this.dataset.promotionName || "";
            const description = this.dataset.description || "";
            const discountType = this.dataset.discountType || "PERCENT";
            const discountValue = this.dataset.discountValue || "";
            const startDate = this.dataset.startDate || "";
            const endDate = this.dataset.endDate || "";
            const maxUser = this.dataset.maxUser || "";
            const maxOrder = this.dataset.maxOrder || "";
            const isMilestone = (this.dataset.isMilestone || "false").toLowerCase() === "true";
            const requiredOrderCount = this.dataset.requiredOrderCount || "";
            const menuIdsRaw = this.dataset.menuIds || "[]";

            if (editPromotionId) editPromotionId.value = promotionId;
            if (editPromotionName) editPromotionName.value = promotionName;
            if (editDescription) editDescription.value = description;
            if (editDiscountType) editDiscountType.value = discountType;
            if (editDiscountValue) editDiscountValue.value = discountValue;
            if (editStartDate) editStartDate.value = startDate;
            if (editEndDate) editEndDate.value = endDate;
            if (editMaxUser) editMaxUser.value = maxUser;
            if (editMaxOrder) editMaxOrder.value = maxOrder;

            if (editIsMilestone) editIsMilestone.checked = isMilestone;
            if (editRequiredOrderCount) editRequiredOrderCount.value = requiredOrderCount;

            updateEditDiscountUI();
            toggleEditMilestoneFields();

            let menuIds = [];
            try {
                menuIds = JSON.parse(menuIdsRaw);
            } catch (e) {
                menuIds = [];
            }

            document.querySelectorAll("#editPromotionModal input[name='SelectedMenuIds']").forEach(cb => {
                cb.checked = menuIds.includes(cb.value);
            });
        });
    });

    // =========================
    // DELETE CONFIRM
    // =========================
    document.querySelectorAll(".form-delete-promo").forEach(form => {
        form.addEventListener("submit", function (e) {
            const ok = confirm("คุณแน่ใจหรือไม่ว่าต้องการลบโปรโมชั่นนี้?");
            if (!ok) {
                e.preventDefault();
            }
        });
    });

});
</script>