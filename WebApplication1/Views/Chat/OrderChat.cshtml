@model WebApplication1.FoodViewModels.ChatViewModel

@using System.Security.Claims

@{
    ViewData["Title"] = "แชทออเดอร์";

    bool isCustomer = Model.IsCustomerOwner;
    bool isOwner = User.IsInRole("OWNER");
    bool isEmployee = User.IsInRole("EMPLOYEE");

    if (isCustomer)
    {
        Layout = "_NavbarUserLayout";
    }
    else if (isOwner)
    {
        Layout = "_NavbarOwnerLayout";
    }
    else
    {
        Layout = "_NavbarEmployeeLayout";
    }

    string GetOrderStatusText(ulong? status)
    {
        return status switch
        {
            1 => "รอพนักงานยืนยันออเดอร์",
            2 => "รอชำระเงิน",
            3 => "รอตรวจสอบการชำระเงิน",
            4 => "ชำระเงินแล้ว / กำลังเตรียมอาหาร",
            5 => "กำลังจัดส่ง",
            6 => "ถึงปลายทาง / รอรับอาหาร",
            7 => "สำเร็จแล้ว (ปิดการส่งข้อความ)",
            8 => "ออเดอร์ถูกปฏิเสธ (ปิดการส่งข้อความ)",
            _ => "ไม่ทราบสถานะ"
        };
    }

    string GetOrderStatusBadgeClass(ulong? status)
    {
        return status switch
        {
            1 => "bg-warning text-dark",
            2 => "bg-info text-dark",
            3 => "bg-primary",
            4 => "bg-secondary",
            5 => "bg-dark",
            6 => "bg-success",
            7 => "bg-success",
            8 => "bg-danger",
            _ => "bg-light text-dark"
        };
    }
}

<style>
    .chat-page-wrap {
        max-width: 1000px;
        margin: 0 auto;
    }

    .chat-main-card {
        border: 0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        background: #fff;
    }

    .chat-header {
        background: linear-gradient(135deg, #fff8ea, #fff3d6);
        border-bottom: 1px solid #f2e4be;
    }

    .chat-room-box {
        height: 60vh;
        min-height: 420px;
        max-height: 70vh;
        overflow-y: auto;
        background:
            radial-gradient(circle at top right, rgba(255, 243, 214, 0.6), transparent 30%),
            radial-gradient(circle at bottom left, rgba(255, 248, 234, 0.9), transparent 35%),
            #fffdf8;
        padding: 24px;
    }

    .message-row {
        display: flex;
        margin-bottom: 16px;
    }

    .message-row.mine {
        justify-content: flex-end;
    }

    .message-row.other {
        justify-content: flex-start;
    }

    .message-bubble-wrap {
        max-width: 75%;
    }

    .sender-label {
        font-size: 12px;
        margin-bottom: 4px;
        color: #7a7a7a;
        font-weight: 600;
        padding: 0 8px;
    }

    .message-bubble {
        border-radius: 18px;
        padding: 12px 16px;
        word-break: break-word;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
        line-height: 1.5;
        white-space: pre-wrap;
    }

    .message-bubble.mine {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        color: white;
        border-bottom-right-radius: 6px;
    }

    .message-bubble.other {
        background: white;
        color: #2f2f2f;
        border: 1px solid #f0e4c3;
        border-bottom-left-radius: 6px;
    }

    .message-time {
        font-size: 11px;
        color: #8b8b8b;
        margin-top: 5px;
        padding: 0 8px;
    }

    .chat-input-area {
        border-top: 1px solid #f0e4c3;
        background: #fffaf0;
    }

    .chat-textarea {
        resize: none;
        border-radius: 16px;
        border: 1px solid #e8d7aa;
        padding: 12px 14px;
        min-height: 58px;
    }

    .chat-textarea:focus {
        border-color: #d4a017;
        box-shadow: 0 0 0 0.15rem rgba(212, 160, 23, 0.15);
    }

    .btn-chat-send {
        border-radius: 16px;
        padding: 12px 18px;
        font-weight: 700;
        border: 0;
        background: linear-gradient(135deg, #b45309, #d97706);
        color: white;
        min-width: 120px;
    }

    .btn-chat-send:hover {
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(180, 83, 9, 0.25);
    }

    .empty-chat-box {
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #8c8c8c;
    }

    .system-note {
        border-radius: 16px;
        background: #fff3cd;
        border: 1px solid #ffe69c;
        color: #664d03;
    }

    @@media (max-width: 768px) {
        .chat-room-box {
            height: 55vh;
            min-height: 350px;
            padding: 16px;
        }

        .message-bubble-wrap {
            max-width: 90%;
        }
    }
</style>

<div class="container py-4">
    <div class="chat-page-wrap">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-4 mb-3">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-3">
                @TempData["Error"]
            </div>
        }

        <div class="chat-main-card">

            <!-- Header -->
            <div class="chat-header p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                            <h3 class="fw-bold mb-0">แชทเกี่ยวกับออเดอร์ #@Model.OrderId</h3>

                            <span class="badge rounded-pill px-3 py-2 @GetOrderStatusBadgeClass(Model.OrderStatus)">
                                @GetOrderStatusText(Model.OrderStatus)
                            </span>
                        </div>

                        <div class="text-muted">
                            @if (Model.IsCustomerOwner)
                            {
                                <span>กำลังคุยกับทางร้าน / พนักงาน</span>
                            }
                            else
                            {
                                <span>
                                    ลูกค้า:
                                    <span class="fw-semibold text-dark">
                                        @(string.IsNullOrWhiteSpace(Model.CustomerName) ? Model.CustomerUserId : Model.CustomerName)
                                    </span>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.IsCustomerOwner)
                        {
                            <a asp-controller="Order"
                               asp-action="OrderStatus"
                               class="btn btn-outline-secondary rounded-4 px-3">
                                ← กลับหน้าสถานะออเดอร์
                            </a>
                        }
                        else if (User.IsInRole("OWNER"))
                        {
                            <a asp-controller="Order"
                               asp-action="OrderList"
                               class="btn btn-outline-secondary rounded-4 px-3">
                                ← กลับหน้าจัดการออเดอร์
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Order"
                               asp-action="HistoryEmployee"
                               class="btn btn-outline-secondary rounded-4 px-3">
                                ← กลับหน้ารายการออเดอร์
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Chat Messages -->
            <div id="chatScrollBox" class="chat-room-box">

                @if (Model.Messages != null && Model.Messages.Any())
                {
                    @foreach (var msg in Model.Messages)
                    {
                        <div class="message-row @(msg.IsMine ? "mine" : "other")">
                            <div class="message-bubble-wrap">

                                <div class="sender-label @(msg.IsMine ? "text-end" : "text-start")">
                                    @(msg.IsMine ? "คุณ" : msg.SenderName)
                                </div>

                                <div class="message-bubble @(msg.IsMine ? "mine" : "other")">
                                    @msg.MessageText
                                </div>

                                <div class="message-time @(msg.IsMine ? "text-end" : "text-start")">
                                    @msg.SentAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-chat-box">
                        <div>
                            <div class="fs-5 fw-bold mb-2">ยังไม่มีข้อความในห้องแชทนี้</div>
                            <div>เริ่มส่งข้อความแรกเพื่อคุยเรื่องออเดอร์นี้ได้เลย 💬</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Input -->
            <div class="chat-input-area p-3 p-md-4">
                @if (Model.CanSendMessage)
                {
                    <form asp-controller="Chat" asp-action="SendMessage" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="chatRoomId" value="@Model.ChatRoomId" />

                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md">
                                <label class="form-label fw-semibold mb-2">พิมพ์ข้อความ</label>
                                <textarea name="messageText"
                                          class="form-control chat-textarea"
                                          rows="2"
                                          maxlength="1000"
                                          placeholder="พิมพ์ข้อความถึงอีกฝ่ายได้ที่นี่..."></textarea>
                                <div class="form-text">สูงสุด 1000 ตัวอักษร</div>
                            </div>

                            <div class="col-12 col-md-auto">
                                <button type="submit" class="btn btn-chat-send w-100">
                                    ส่งข้อความ
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="system-note p-3">
                        <div class="fw-bold mb-1">ห้องแชทนี้ปิดการส่งข้อความแล้ว</div>
                        <div class="small">
                            เนื่องจากออเดอร์นี้สิ้นสุดแล้ว (สำเร็จ / ถูกปฏิเสธ) คุณยังสามารถอ่านข้อความย้อนหลังได้ แต่ไม่สามารถส่งข้อความใหม่ได้
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    (function () {
        const box = document.getElementById('chatScrollBox');
        if (box) {
            box.scrollTop = box.scrollHeight;
        }
    })();
</script>